# Copy this file to .env and replace the placeholder values
# DO NOT commit .env to git - it contains your secret keys

TELEGRAM_BOT_TOKEN=paste_your_telegram_bot_token_here
GEMINI_API_KEY=paste_your_gemini_api_key_here

# Optional: how Friday addresses you (e.g. your name, "Boss", "Sir")
OWNER_NAME=Sir

# Optional: change the Gemini model (default works fine for most users)
GEMINI_MODEL=gemini-2.5-flash
