# Copy this file to .env and replace the placeholder values
# DO NOT commit .env to git - it contains your secret keys

TELEGRAM_BOT_TOKEN=paste_your_telegram_bot_token_here
GEMINI_API_KEY=paste_your_gemini_api_key_here

# How Friday addresses you
OWNER_NAME=Sir

# Gemini model (free tier)
GEMINI_MODEL=gemini-2.5-flash

# ----------------------------------------------------------------------
# Voice settings (Phase 2) - controls how Friday's voice replies sound
# ----------------------------------------------------------------------
# TTS_LANG: language code, e.g. "en", "hi", "es", "ta"
# TTS_TLD : accent (gTTS uses Google Translate domains)
#   "co.in"  = Indian English (default)
#   "us"     = American English
#   "co.uk"  = British English
#   "com.au" = Australian English
#   "ca"     = Canadian English
TTS_LANG=en
TTS_TLD=co.in
